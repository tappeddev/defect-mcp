{
  "name": "defect-mcp",
  "version": "0.1.0",
  "description": "MCP server providing prompts to triage, analyse and fix defects from Jira tickets",
  "type": "module",
  "bin": {
    "defect-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
